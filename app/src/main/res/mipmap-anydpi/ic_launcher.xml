<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Full-bleed navy removes the white corner/edge area from the supplied artwork. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#010028" />
        </shape>
    </item>

    <!-- The original rounded-square YW mark now fills 75% of the icon instead of ~55%. -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#55D8CE"
                android:centerColor="#2874F4"
                android:endColor="#D94DE8" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Hollow center. -->
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#010028" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- The original full-height center divider. -->
    <item android:left="22dp" android:top="10dp" android:right="22dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#55D8CE"
                android:centerColor="#2874F4"
                android:endColor="#D94DE8" />
        </shape>
    </item>

    <!-- Upper-left horizontal divider. -->
    <item android:left="7dp" android:top="20dp" android:right="22dp" android:bottom="26dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#55D8CE"
                android:endColor="#2874F4" />
        </shape>
    </item>

    <!-- Lower-right horizontal divider. -->
    <item android:left="22dp" android:top="31dp" android:right="7dp" android:bottom="15dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#2874F4"
                android:endColor="#D94DE8" />
        </shape>
    </item>
</layer-list>